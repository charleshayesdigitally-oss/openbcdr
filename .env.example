# One of these, or run `ant auth login` and set neither.
ANTHROPIC_API_KEY=sk-ant-...
# Optional overrides
BCDR_MODEL=claude-opus-5
BCDR_EFFORT=high
BCDR_DB=bcdr.sqlite3
# Sandbox refuses everything if config/boundary_patterns.local.txt is missing.
# Set to 1 ONLY to accept generic-only deny-list protection on purpose.
# BCDR_ALLOW_NO_LOCAL_PATTERNS=1
